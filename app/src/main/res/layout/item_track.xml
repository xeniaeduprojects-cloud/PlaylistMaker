<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/track_item_horizontal_padding"
    android:paddingEnd="@dimen/track_item_horizontal_padding"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingBottom="@dimen/spacing_sm"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/img_album_art"
        android:layout_width="@dimen/track_item_album_art_size"
        android:layout_height="@dimen/track_item_album_art_size"
        android:layout_gravity="center_vertical"
        android:scaleType="centerCrop"
        android:contentDescription="@string/album_art_description" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/spacing_md"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_track_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:textColor="?attr/colorOnSecondary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_track_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/yp_track_subtitle"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <ImageView
        android:id="@+id/img_track_chevron"
        android:layout_width="@dimen/track_item_chevron_size"
        android:layout_height="@dimen/track_item_chevron_size"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_arrow_forward"
        android:contentDescription="@string/view_track_description"
        app:tint="@color/yp_track_chevron" />

</LinearLayout>
