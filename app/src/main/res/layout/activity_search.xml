<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSecondary"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSearch"
        style="@style/ScreenToolbar"
        app:title="@string/search" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:background="@drawable/rounded_search_bar">

        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autofillHints="search"
            android:background="@null"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="@dimen/spacing_sm"
            android:hint="@string/search"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/search_padding_end"
            android:textColor="@color/yp_black"
            android:textColorHint="@color/yp_search_hint"
            android:textSize="@dimen/text_body" />

        <ImageView
            android:id="@+id/searchClearButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/clear_search"
            android:src="@drawable/ic_cross"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/nothingFoundText"
        style="@style/ErrorMessage"
        android:text="@string/nothing_found"
        android:contentDescription="@string/nothing_found_ic_description"
        app:drawableTopCompat="@drawable/ic_nothing_found" />

    <LinearLayout
        android:id="@+id/noConnectionLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/noConnectionText"
            style="@style/ErrorMessage"
            android:visibility="visible"
            android:text="@string/no_connection"
            android:contentDescription="@string/no_connection_ic_description"
            app:drawableTopCompat="@drawable/ic_no_connection" />

        <Button
            android:id="@+id/refreshButton"
            style="@style/RefreshButton"
            android:text="@string/refresh" />
    </LinearLayout>


    <TextView
        android:id="@+id/searchHistoryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/you_searched_text_view"
        android:textColor="@color/yp_black"
        android:fontFamily="@font/ys_display_medium"
        android:textSize="19sp"
        android:letterSpacing="0"
        android:gravity="center_horizontal"
        android:paddingTop="18dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tracksRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/spacing_lg"
        android:clipToPadding="false" />

    <Button
        android:id="@+id/clearHistoryButton"
        style="@style/RefreshButton"
        android:text="@string/clean_history_btn"
        android:visibility="gone" />


</LinearLayout>