<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/yp_blue</item>
        <item name="colorOnPrimary">@color/yp_white</item>
        <item name="colorSecondary">@color/yp_white</item>
        <item name="colorOnSecondary">@color/yp_black</item>
        <item name="colorControlActivated">@color/yp_blue</item>
    </style>

    <style name="SettingsToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="AppToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">@dimen/toolbar_padding_top</item>
        <item name="android:paddingBottom">@dimen/spacing_xs</item>
        <item name="titleTextAppearance">@style/SettingsToolbarTitle</item>
    </style>

    <style name="ScreenToolbar" parent="AppToolbar">
        <item name="navigationIcon">@drawable/ic_arrow_left</item>
        <item name="navigationIconTint">?attr/colorOnSecondary</item>
        <item name="titleTextColor">?attr/colorOnSecondary</item>
    </style>

    <style name="SettingsMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">@dimen/spacing_lg</item>
        <item name="android:paddingVertical">@dimen/spacing_xl</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
    </style>

    <style name="MainMenuButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/rounded_button</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/yp_black</item>
    </style>

    <style name="ErrorMessage">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:textAlignment">center</item>
        <item name="android:drawablePadding">@dimen/spacing_md</item>
        <item name="android:layout_marginTop">102dp</item>
        <item name="android:layout_marginHorizontal">24dp</item>
        <item name="android:paddingBottom">24dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/text_error</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="RoundedButtonBase" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/rounded_refresh_button</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">0dp</item>
        <item name="contentPaddingTop">10dp</item>
        <item name="contentPaddingBottom">10dp</item>
        <item name="contentPaddingLeft">14dp</item>
        <item name="contentPaddingRight">14dp</item>
    </style>

    <style name="RoundedButton" parent="RoundedButtonBase">
        <item name="android:textColor">@color/yp_white</item>
    </style>

    <!-- Player Styles -->
    <style name="PlayerMetaInfoLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/spacing_xxl</item>
        <item name="android:layout_marginTop">@dimen/spacing_lg</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/yp_grey</item>
        <item name="android:textSize">@dimen/player_meta_info_text_size</item>
    </style>

    <style name="PlayerMetaInfoValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">@dimen/spacing_xxl</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="android:textSize">@dimen/player_meta_info_text_size</item>
    </style>
</resources>